# ── Required ──
NEXT_PUBLIC_SUPABASE_URL=https://bkaigyrrzsqbfscyznzw.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=eyJ...  # from Supabase Dashboard → Project Settings → API → service_role

# App URL
NEXT_PUBLIC_CUSTOMER_ORIGIN=http://localhost:3002

# hCaptcha (Optional — needed for signup)
NEXT_PUBLIC_HCAPTCHA_SITE_KEY=your-site-key
HCAPTCHA_SECRET_KEY=your-secret-key

# M-Pesa Master Encryption Key (Required for M-Pesa)
MPESA_KMS_KEY=your-mpesa-kms-key

# DeepSeek API (Optional — AI receipt parsing)
DEEPSEEK_API_KEY=your-deepseek-key

# EC2 Parser URL (Optional)
EC2_PARSER_URL=http://your-ec2-instance:3100

# Upstash Redis (Required — caching, pub/sub, rate limiting)
# Create a free database at https://console.upstash.com
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# ── Additional keys present in .env.local (add real values locally) ──
